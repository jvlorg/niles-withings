@@ -0,0 +1,64 @@
+import { useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { Switch } from "@/components/ui/switch";
+import { api, valueAt } from "@/lib/api";
+import type { PluginSummary } from "@/lib/api";
+
+function hiddenPages(effective: unknown): string[] {
+  const value = valueAt(effective, "menu.hidden");
+  return Array.isArray(value) ? value.filter((id): id is string => typeof id === "string") : [];
+}
+
+/** Menu presentation only: never changes plugin enablement or provider settings. */
+export function PluginPageVisibility({ plugin, effective }: {
+  plugin: PluginSummary;
+  effective: unknown;
+}) {
+  const client = useQueryClient();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const hidden = hiddenPages(effective);
+
+  async function change(id: string, shown: boolean) {
+    setBusy(true);
+    setError(null);
+    try {
+      // Read the current list so another page's visibility is preserved.
+      const current = await api.getConfig();
+      const next = hiddenPages(current.effective).filter((entry) => entry !== id);
+      if (!shown) next.push(id);
+      await api.patchConfig({ menu: { hidden: next } });
+      // Read back canonical state; a failed write must not flip the switch.
+      const confirmed = await api.getConfig();
+      client.setQueryData(["config"], confirmed);
+      if (hiddenPages(confirmed.effective).includes(id) === shown) {
+        throw new Error("Page visibility was not saved. Try again.");
+      }
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Could not save page visibility.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  if (plugin.menu.length === 0) return null;
+  return (
+    <section aria-label="Page visibility" className="flex flex-col gap-3 border-b pb-4">
+      {plugin.menu.map((page) => {
+        const id = `${plugin.id}.${page.id}`;
+        const label = `Show ${page.label} page`;
+        return (
+          <div key={id} className="flex items-center justify-between gap-3">
+            <div className="min-w-0">
+              <p className="text-sm font-medium">{label}</p>
+              <p className="text-muted-foreground text-xs">Show in the menu. Automations keep running when hidden.</p>
+            </div>
+            <Switch aria-label={label} checked={!hidden.includes(id)}
+              disabled={busy || effective === undefined} onCheckedChange={(shown) => void change(id, shown)} />
+          </div>
+        );
+      })}
+      {error && <p role="alert" className="text-destructive text-sm">{error}</p>}
+    </section>
+  );
+}
