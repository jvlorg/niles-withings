diff --git a/web/src/components/PluginSettingsAlignment.test.tsx b/web/src/components/PluginSettingsAlignment.test.tsx
new file mode 100644
index 0000000..c83a79d
--- /dev/null
+++ b/web/src/components/PluginSettingsAlignment.test.tsx
@@ -0,0 +1,83 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { QueryClient, QueryClientProvider, useQuery } from "@tanstack/react-query";
+import { PluginPageVisibility } from "./PluginPageVisibility";
+import { PluginSettings } from "./PluginSettings";
+import { api } from "@/lib/api";
+import type { PluginSetting, PluginSummary } from "@/lib/api";
+import { menuLayout } from "@/lib/menu";
+
+const setting = (key: string): PluginSetting => ({ key, label: key, type: "string", required: true,
+  help: null, default: null, options: [], min: null, max: null, value: "original", set: true });
+const plugin = { id: "withings", enabled: true, settings: [setting("client_id"), setting("another")],
+  menu: [{ id: "withings", label: "Withings", icon: "bed", refresh_every: null }] } as PluginSummary;
+afterEach(() => vi.restoreAllMocks());
+
+function visibility() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  function Host() {
+    const config = useQuery({ queryKey: ["config"], queryFn: api.getConfig });
+    const layout = menuLayout(config.data?.effective, false, ["withings.withings"]);
+    return <><PluginPageVisibility plugin={plugin} effective={config.data?.effective} />
+      {layout.main.filter((p) => !p.hidden).map((p) => <a key={p.id}>{p.id}</a>)}</>;
+  }
+  return render(<QueryClientProvider client={client}><Host /></QueryClientProvider>);
+}
+
+describe("settings alignment", () => {
+  it("saves only the input beside the submitted button, retaining another draft", async () => {
+    const patch = vi.spyOn(api, "patchConfig").mockResolvedValue({} as never);
+    render(<PluginSettings plugin={plugin} rooms={[]} onSaved={() => {}} />);
+    fireEvent.change(screen.getByRole("textbox", { name: "client_id" }), { target: { value: "new-id" } });
+    fireEvent.change(screen.getByRole("textbox", { name: "another" }), { target: { value: "unsaved" } });
+    fireEvent.click(screen.getByRole("button", { name: "Save client_id" }));
+    await waitFor(() => expect(patch).toHaveBeenCalledWith({ plugins: { withings: { client_id: "new-id" } } }));
+    expect(screen.getByRole("textbox", { name: "another" })).toHaveValue("unsaved");
+    expect(await screen.findByRole("status")).toHaveTextContent("Saved.");
+  });
+  it("keeps validation and failed-save feedback", async () => {
+    const patch = vi.spyOn(api, "patchConfig").mockRejectedValue(new Error("Save failed"));
+    render(<PluginSettings plugin={{ ...plugin, settings: [{ ...setting("client_id"), type: "number", value: 3 }] }} rooms={[]} onSaved={() => {}} />);
+    fireEvent.change(screen.getByRole("textbox", { name: "client_id" }), { target: { value: "invalid-number" } });
+    fireEvent.click(screen.getByRole("button", { name: "Save client_id" }));
+    expect(patch).not.toHaveBeenCalled();
+    expect(screen.getByRole("alert")).toBeInTheDocument();
+    fireEvent.change(screen.getByRole("textbox", { name: "client_id" }), { target: { value: "7" } });
+    fireEvent.click(screen.getByRole("button", { name: "Save client_id" }));
+    expect(await screen.findByText("Save failed")).toBeInTheDocument();
+    expect(screen.queryByRole("status")).not.toBeInTheDocument();
+  });
+  it("persists hiding/showing, preserves other entries and never disables the plugin", async () => {
+    let effective = { menu: { hidden: ["other.page"] } };
+    vi.spyOn(api, "getConfig").mockImplementation(async () => ({ effective }) as never);
+    const patch = vi.spyOn(api, "patchConfig").mockImplementation(async (body) => {
+      effective = body as typeof effective; return {} as never;
+    });
+    const view = visibility();
+    const toggle = await screen.findByRole("switch", { name: "Show Withings page" });
+    await waitFor(() => expect(toggle).not.toHaveAttribute("aria-disabled", "true"));
+    fireEvent.click(toggle);
+    await waitFor(() => expect(toggle).not.toBeChecked());
+    expect(patch).toHaveBeenLastCalledWith({ menu: { hidden: ["other.page", "withings.withings"] } });
+    expect(screen.queryByText("withings.withings")).not.toBeInTheDocument();
+    view.unmount(); visibility();
+    const reopened = screen.getByRole("switch");
+    await waitFor(() => expect(reopened).not.toHaveAttribute("aria-disabled", "true"));
+    expect(reopened).not.toBeChecked();
+    fireEvent.click(reopened);
+    await waitFor(() => expect(reopened).toBeChecked());
+    expect(patch).toHaveBeenLastCalledWith({ menu: { hidden: ["other.page"] } });
+    expect(screen.getByText("withings.withings")).toBeInTheDocument();
+    expect(plugin.enabled).toBe(true);
+  });
+  it("leaves visibility unchanged on write failure", async () => {
+    vi.spyOn(api, "getConfig").mockResolvedValue({ effective: { menu: { hidden: [] } } } as never);
+    vi.spyOn(api, "patchConfig").mockRejectedValue(new Error("Write refused"));
+    visibility();
+    const toggle = screen.getByRole("switch");
+    await waitFor(() => expect(toggle).not.toHaveAttribute("aria-disabled", "true"));
+    fireEvent.click(toggle);
+    expect(await screen.findByRole("alert")).toHaveTextContent("Write refused");
+    expect(toggle).toBeChecked();
+  });
+});
